[Unit]
Description=GameStreamPi: automatically pair Xbox controllers in pairing mode
Requires=bluetooth.service gamestreampi-bt-agent.service
After=bluetooth.service gamestreampi-bt-agent.service

[Service]
ExecStart=/usr/local/bin/gamestreampi-autopair
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
