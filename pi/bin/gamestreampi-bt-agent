#!/usr/bin/env python3
"""Bluetooth pairing agent for GameStreamPi.

BlueZ asks a registered agent to confirm every pairing (on a desktop, this is
the "Pair with this device?" popup). With no agent, pairing fails with
"No agent available". This agent confirms pairing for Xbox controllers only,
so nearby phones or keyboards can't pair with the Pi and send input to the PC.

Runs as root under gamestreampi-bt-agent.service; logs go to the journal.
"""

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

BUS_NAME = "org.bluez"
AGENT_PATH = "/gamestreampi/agent"
# Controllers have no screen or keypad, so pairing is "just works".
CAPABILITY = "NoInputNoOutput"


class Rejected(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Rejected"


def log(message):
    print(message, flush=True)


def device_name(device_path):
    props = dbus.Interface(
        bus.get_object(BUS_NAME, device_path), "org.freedesktop.DBus.Properties"
    )
    # Alias is always present; it falls back to the address if there's no name.
    return str(props.Get("org.bluez.Device1", "Alias"))


def require_controller(device_path, action):
    name = device_name(device_path)
    if "Xbox" in name and "Controller" in name:
        log(f"Accepting {action} for {name} ({device_path})")
        return
    log(f"Rejecting {action} for non-controller {name} ({device_path})")
    raise Rejected("Only Xbox controllers may pair with this device")


class Agent(dbus.service.Object):
    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Release(self):
        log("Agent released")

    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="")
    def RequestConfirmation(self, device, passkey):
        require_controller(device, "pairing")

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="")
    def RequestAuthorization(self, device):
        require_controller(device, "pairing")

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def AuthorizeService(self, device, uuid):
        require_controller(device, f"service {uuid}")

    # Controllers never use PIN or passkey entry; reject anything that asks.
    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="s")
    def RequestPinCode(self, device):
        raise Rejected("PIN pairing is not supported")

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="u")
    def RequestPasskey(self, device):
        raise Rejected("Passkey pairing is not supported")

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def DisplayPinCode(self, device, pincode):
        pass

    @dbus.service.method("org.bluez.Agent1", in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device, passkey, entered):
        pass

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Cancel(self):
        log("Pairing request cancelled")


dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
bus = dbus.SystemBus()
Agent(bus, AGENT_PATH)

manager = dbus.Interface(bus.get_object(BUS_NAME, "/org/bluez"), "org.bluez.AgentManager1")
manager.RegisterAgent(AGENT_PATH, CAPABILITY)
manager.RequestDefaultAgent(AGENT_PATH)
log("Pairing agent registered (accepting Xbox controllers only)")

# The service is PartOf bluetooth.service, so systemd restarts us (and we
# re-register) whenever bluetoothd restarts.
GLib.MainLoop().run()
